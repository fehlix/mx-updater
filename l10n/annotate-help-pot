    'MX_REPO_MANAGER':        'bold proper name: MX Repo Manager -- do not translate',
    'CONF_FILE':              'code: config file path -- do not translate',
    'OPT_ASSUME_YES':         'code: apt/Nala command-line option -- do not translate',
    'ADMIN_CONF_LINK':        'hyperlink: admin config example -- do not translate',
}

UI_HEADING_NOTE = {
    'Upgrade Mode':   'Matches the "Upgrade Mode" section label in the settings window -- use the same translation as in mx-updater.po.',
    'Icons':          'Matches the "Icons" section label in the settings window -- use the same translation as in mx-updater.po.',
    'Other':          'Matches the "Other" section label in the settings window -- use the same translation as in mx-updater.po.',
    'Left-Click':     'Left-click action section heading.',
    'Right-Click Menu': 'Right-click tray context menu section heading.',
}

_AUTO_PREFIX = '#. Token '


def annotate_block(block):
    msgid_m = re.search(r'^msgid "(.*)"', block, re.MULTILINE)
    if not msgid_m:
        return block
    msgid = msgid_m.group(1)

    notes = []
    for token in re.findall(r'%%([A-Z0-9_]+)%%', msgid):
        if token in TOKEN_DESC:
            notes.append(f'{_AUTO_PREFIX}%%{token}%%: {TOKEN_DESC[token]}.')
    for heading, note in UI_HEADING_NOTE.items():
        if msgid == heading:
            notes.append(f'#. {note}')

    if not notes:
        return block

    # Remove previously injected auto-notes to stay idempotent on re-runs
    block = re.sub(rf'^{re.escape(_AUTO_PREFIX)}.*\n', '', block, flags=re.MULTILINE)

    comment_block = '\n'.join(notes)
    block = re.sub(r'^(msgid ")', f'{comment_block}\n\\1', block, count=1, flags=re.MULTILINE)
    return block


def main():
    if len(sys.argv) != 2:
        sys.exit('Usage: annotate-help-pot <pot_file>')
    path = sys.argv[1]
    with open(path, encoding='utf-8') as f:
        content = f.read()

    blocks = re.split(r'(?=\n(?:#[^\n]*\n)*msgid ")', content)
    result = ''.join(annotate_block(b) for b in blocks)

    with open(path, 'w', encoding='utf-8') as f:
        f.write(result)


if __name__ == '__main__':
    main()
