#!/usr/bin/python3
"""Inject translator comments into mx-updater-help.pot for msgids containing %%TOKEN%% placeholders."""
import re, sys

TOKEN_DESC = {
    'PREFS_WINDOW':           'bold: MX Updater preferences window title -- translate as the window is known in your language',
    'FULL':                   'bold UI label: full upgrade mode',
    'BASIC':                  'bold UI label: basic upgrade mode',
