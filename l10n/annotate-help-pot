    'AUTOMATIC':              'bold UI label: automatic/unattended upgrades checkbox',
    'VIEW_AND_UPGRADE':       'bold UI label: tray left-click / menu entry',
    'CHECK_FOR_UPDATES':      'bold UI label: tray menu entry',
    'HISTORY':                'bold UI label: tray menu entry',
    'AUTO_UPDATE_LOGS':       'bold UI label: tray menu entry',
    'AUTO_UPDATE_DPKG_LOGS':  'bold UI label: tray menu entry',
    'HELP':                   'bold UI label: tray menu entry',
    'PREFERENCES':            'bold UI label: tray menu entry (settings window)',
    'ABOUT':                  'bold UI label: tray menu entry',
    'RESTART_MX_UPDATER':     'bold UI label: tray menu entry',
    'HIDE_WHEN_NO_UPDATES':   'bold UI label: tray icon toggle',
    'QUIT':                   'bold UI label: tray menu entry',
    'BASIC_UPGRADE':          'bold UI label: basic upgrade mode',
    'TRANSPARENT_WIREFRAME':  'bold UI label: icon style toggle',
    'TERMINAL_SIZE':          'bold UI label: settings option name',
    'POSITION':               'bold UI label: settings option name',
    'SKIP_UPGRADE_CONFIRMATION': 'bold UI label: settings option name',
    'DESKTOP_NOTIFICATIONS':  'bold UI label: settings option name',
    'AUTOSTART_DELAY':        'bold UI label: settings option name',
    'MX_TOOLS':               'bold label: MX Tools launcher -- translate as it is known in your language',
    'SYSTEM_MENU':            'bold label: desktop system/applications menu -- translate naturally',
    'SIZE_DEFAULT':           'italic combo-box label: default terminal size -- use your UI translation for "default"',
    'SIZE_ONE_THIRD':         'italic combo-box label: 1/3 screen -- use your UI translation for "1/3 screen"',
    'SIZE_HALF':              'italic combo-box label: 1/2 screen -- use your UI translation for "1/2 screen"',
    'SIZE_TWO_THIRDS':        'italic combo-box label: 2/3 screen -- use your UI translation for "2/3 screen"',
