#!/usr/bin/python3
import gettext, os, re, sys

# Each entry: (msgid_for_gettext_lookup, kind)
#   kind 'b'     -- look up via gettext, wrap in <b>
#   kind 'i'     -- look up via gettext, wrap in <i>
#   kind 'b_lit' -- literal proper name in <b>, no lookup
#   kind 'code'  -- literal in <code>, no lookup
#   kind 'raw'   -- raw HTML string, no lookup
TOKENS = {
    # UI labels resolved via gettext -> <b>
    'PREFS_WINDOW':           ('MX Updater Preferences',                 'b'),
    'FULL':                   ('full',                                    'b'),
    'BASIC':                  ('basic',                                   'b'),
    'REFRESH':                ('refresh',                                 'b'),
    'AUTOMATIC':              ('automatic upgrade',                        'b'),
    'VIEW_AND_UPGRADE':       ('View and Upgrade',                        'b'),
    'CHECK_FOR_UPDATES':      ('Check for Updates',                       'b'),
    'HISTORY':                ('History',                                 'b'),
    'AUTO_UPDATE_LOGS':       ('Auto-update log(s)',                      'b'),
    'AUTO_UPDATE_DPKG_LOGS':  ('Auto-update dpkg log(s)',                 'b'),
    'HELP':                   ('Help',                                    'b'),
    'PREFERENCES':            ('Preferences',                             'b'),
    'ABOUT':                  ('About',                                   'b'),
    'RESTART_MX_UPDATER':     ('Restart MX Updater',                     'b'),
    'HIDE_WHEN_NO_UPDATES':   ('hide when no updates',                   'b'),
    'QUIT':                   ('Quit',                                    'b'),
    'BASIC_UPGRADE':          ('basic upgrade',                           'b'),
    'TRANSPARENT_WIREFRAME':  ('transparent black/white wireframe',       'b'),
    'TERMINAL_SIZE':          ('terminal size',                           'b'),
    'POSITION':               ('position',                                'b'),
    'SKIP_UPGRADE_CONFIRMATION': ('skip upgrade confirmation',            'b'),
    'DESKTOP_NOTIFICATIONS':  ('desktop notifications',                   'b'),
    'AUTOSTART_DELAY':        ('autostart delay',                         'b'),
    'MX_TOOLS':               ('MX Tools',                               'b'),
    'SYSTEM_MENU':            ('System Menu',                             'b'),
    # Heading tokens -- resolved via gettext, wrapped in heading tag by substitute()
    'UPGRADE_MODE':           ('Upgrade Mode',                            'b'),
    'LEFT_CLICK':             ('Left-Click',                              'b'),
    'RIGHT_CLICK_MENU':       ('Right-Click Menu',                        'b'),
    'ICONS':                  ('Icons',                                   'b'),
    'OTHER':                  ('Other',                                   'b'),
    # Terminal size combo-box labels resolved via gettext -> <i>
    'SIZE_DEFAULT':           ('default',                                 'i'),
    'SIZE_ONE_THIRD':         ('1/3 screen',                              'i'),
    'SIZE_HALF':              ('1/2 screen',                              'i'),
    'SIZE_TWO_THIRDS':        ('2/3 screen',                              'i'),
    'SIZE_THREE_QUARTERS':    ('3/4 screen',                              'i'),
    'SIZE_NINE_TENTHS':       ('9/10 screen',                             'i'),
    'SIZE_OWN':               ('own',                                     'i'),
    # Proper names in <b> -- not translated
    'NALA':                   ('Nala',                                    'b_lit'),
    'SYNAPTIC':               ('Synaptic',                                'b_lit'),
    'MX_PKG_INSTALLER':       ('MX Package Installer',                    'b_lit'),
    'MX_REPO_MANAGER':        ('MX Repo Manager',                         'b_lit'),
    # Code spans -- not translated
    'CONF_FILE':              ('/usr/local/etc/mx-updater.conf',          'code'),
    'OPT_ASSUME_YES':         ('--assume-yes',                            'code'),
    # Raw HTML link -- not translated
    'ADMIN_CONF_LINK':        ('<a href="file:///usr/share/doc/mx-updater/examples/admin-mx-updater.conf">'
                               '/usr/share/doc/mx-updater/examples/admin-mx-updater.conf</a>', 'raw'),
}

_CSS_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                         '../share/doc/mx-updater/help.css')


def get_translator(localedir, lang):
    try:
        t = gettext.translation('mx-updater', localedir=localedir, languages=[lang])
        return t.gettext
    except FileNotFoundError:
        return lambda s: s


def substitute(html, translate):
    # Resolve heading markers placed by generate-help-in before the comment split.
    # Po4a preserves these comments verbatim; we convert them back to proper headings.
    def _heading_replacer(m):
        tag, token = m.group(1), m.group(2)
        entry = TOKENS.get(token)
        if entry is None:
            return f'<{tag}>{token}</{tag}>'
        text, kind = entry
        translated = translate(text) if kind in ('b', 'i') else text
        return f'<{tag}>{translated}</{tag}>'

    html = re.sub(r'<!-- HEADING:(h[1-6]):([A-Z0-9_]+) -->', _heading_replacer, html)

    def replacer(m):
        token = m.group(1)
        entry = TOKENS.get(token)
        if entry is None:
            return m.group(0)
        text, kind = entry
        if kind == 'b':
            return f'<b>{translate(text)}</b>'
        if kind == 'i':
            return f'<i>{translate(text)}</i>'
        if kind == 'b_lit':
            return f'<b>{text}</b>'
        if kind == 'code':
            return f'<code>{text}</code>'
        if kind == 'raw':
            return text
        return m.group(0)

    def process(segment):
        return re.sub(r'%%([A-Z0-9_]+)%%', replacer, segment)

    parts = re.split(r'(<!--.*?-->)', html, flags=re.DOTALL)
    return ''.join(process(p) if not p.startswith('<!--') else p for p in parts)


def to_html5(html):
    html = re.sub(r'<\?xml[^?]*\?>\s*', '', html)
    html = re.sub(r'<!DOCTYPE\b[^>]*>\s*', '', html, flags=re.IGNORECASE)
    html = re.sub(r'<html\b[^>]*>', '<html>', html, count=1)
    return '<!doctype html>\n' + html.lstrip()


def inline_css(html):
    try:
        with open(_CSS_PATH, encoding='utf-8') as f:
            css = f.read().strip()
    except OSError:
        return html
    lines = '\n'.join('    ' + ln for ln in css.splitlines())
    style_block = f'  <style>\n{lines}\n  </style>'
    return re.sub(r'[ \t]*<link\b[^>]*\bhref="help\.css"[^>]*/>', style_block, html)


def cleanup(html):
    html = re.sub(r'<!--.*?-->\n?', '', html, flags=re.DOTALL)
    html = re.sub(r'\n{3,}', '\n\n', html)
    return html


def main():
    if len(sys.argv) != 4:
        sys.exit('Usage: build-help-html <html_file> <localedir> <lang>')
    html_path, localedir, lang = sys.argv[1], sys.argv[2], sys.argv[3]
    translate = get_translator(localedir, lang)
    with open(html_path, encoding='utf-8') as f:
        html = f.read()
    html = to_html5(html)
    html = substitute(html, translate)
    html = cleanup(html)
    html = inline_css(html)
    with open(html_path, 'w', encoding='utf-8') as f:
        f.write(html)


if __name__ == '__main__':
    main()
